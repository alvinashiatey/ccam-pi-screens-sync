[Unit]
Description=MPV Multi-Screen Video Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
Environment=VIDEO_SYNC_CONFIG=/etc/video-sync/config.ini
Environment=VIDEO_SYNC_ACTIVE=/var/lib/video-sync/active-video
Environment=VIDEO_SYNC_STATUS=/run/video-sync/status.json
RuntimeDirectory=video-sync
RuntimeDirectoryMode=0755
ExecStart=/opt/video-sync/mpv_sync.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
