[Unit]
Description=Pi Sync Web Dashboard
After=network-online.target pi-sync-agent.service
Wants=network-online.target

[Service]
Type=simple
Environment=VIDEO_SYNC_CONFIG=/etc/video-sync/config.ini
Environment=VIDEO_SYNC_STATIC=/opt/video-sync/web
EnvironmentFile=/etc/video-sync/pi-sync.env
ExecStart=/opt/video-sync/dashboard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
